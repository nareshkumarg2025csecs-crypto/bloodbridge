# ==============================================================================
# BLOODBRIDGE ENVIRONMENT CONFIGURATION (.env.example)
# Database Engine: MySQL 8.0.46
# ==============================================================================

# Application Database Connection (Least-privilege: SELECT, INSERT, UPDATE, DELETE)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?options
DATABASE_URL="mysql://bloodbridge_app:CHANGE_ME_IN_PRODUCTION@127.0.0.1:3306/bloodbridge_dev?connection_limit=20&sslmode=preferred"

# Migration / Administration Database Connection (DDL & Schema migrations only)
MIGRATION_DATABASE_URL="mysql://bloodbridge_migrate:CHANGE_ME_IN_PRODUCTION@127.0.0.1:3306/bloodbridge_dev"

# Test Database Connection (Dedicated isolated testing schema)
TEST_DATABASE_URL="mysql://bloodbridge_app:CHANGE_ME_IN_PRODUCTION@127.0.0.1:3306/bloodbridge_test"

# Application Server Port & Timezone
PORT=4000
NODE_ENV="development"
TZ="UTC"

# Security & Tokens (Person 1 backend integration)
JWT_SECRET="CHANGE_ME_JWT_SECRET_MIN_32_CHARS"
SESSION_TIMEOUT_MINUTES=30
RESERVATION_EXPIRY_MINUTES=15
