# ==============================================================================
# BLOODBRIDGE PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# Do NOT store actual production secrets or passwords in this template.
# Copy this file to .env.production on the hosting provider's secure secrets manager.
# ==============================================================================

# Application Runtime Configuration
NODE_ENV="production"
PORT=5000
API_PREFIX="/api/v1"
TZ="UTC"

# Production Frontend Web Origin for CORS
CORS_ORIGIN="https://bloodbridge.yourdomain.com"

# Managed Production MySQL 8.0 Database Connection
# Example Providers: AWS RDS MySQL 8.0, Google Cloud SQL for MySQL, PlanetScale, Aiven, Railway
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl={"rejectUnauthorized":true}&connection_limit=30
DATABASE_URL="mysql://bloodbridge_prod_user:CHANGE_ME_STRONG_PASSWORD@prod-db.yourcloud.com:3306/bloodbridge_prod?sslmode=required"

# Separate Migration User (Used only in CI/CD pipeline runs for DDL schema management)
MIGRATION_DATABASE_URL="mysql://bloodbridge_prod_migrate:CHANGE_ME_MIGRATE_PASSWORD@prod-db.yourcloud.com:3306/bloodbridge_prod?sslmode=required"

# Cryptographic Token Secrets (Must be at least 32-64 random hex characters)
JWT_SECRET="CHANGE_ME_TO_MIN_64_CHAR_HEX_SECRET_STRING_IN_PROD"
JWT_EXPIRATION_TIME=900
JWT_REFRESH_SECRET="CHANGE_ME_TO_ANOTHER_64_CHAR_HEX_REFRESH_SECRET"
JWT_REFRESH_EXPIRATION_TIME=604800
SESSION_TIMEOUT_MINUTES=30
RESERVATION_EXPIRY_MINUTES=15

# Real-Time Telephony / Messaging Services (Optional / As Provisioned)
NEXCONN_API_KEY="CHANGE_ME_NEXCONN_API_KEY"
NEXCONN_APP_ID="CHANGE_ME_NEXCONN_APP_ID"
NEXCONN_ENDPOINT="https://api.nexconn.io/v1"
NEXCONN_SECRET="CHANGE_ME_NEXCONN_SECRET"
